# Copy to backend/.env and fill in real values. Never commit .env.
# The API validates every variable at startup and exits naming any that are invalid.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
PORT=4000
# error | warn | info | debug
LOG_LEVEL=info
# Express "trust proxy": set when behind a reverse proxy / load balancer (e.g. 1). Empty locally.
TRUST_PROXY=

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>/connect
# Local MongoDB also works:  mongodb://127.0.0.1:27017/connect
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/connect?retryWrites=true&w=majority
# Per-attempt server selection timeout, and attempts before the API gives up and exits(1).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_CONNECT_ATTEMPTS=3

# ── Browser clients ──────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS, CSRF origin checks and WebSocket handshakes.
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the web app: used in email links and OAuth redirects (https in production).
WEB_APP_URL=http://localhost:5173

# ── Authentication ───────────────────────────────────────────────────────────
# REQUIRED. At least 32 characters. Generate: openssl rand -base64 48
# Signs access tokens and CSRF tokens (separate keys are derived from it). Rotating it signs everyone out.
AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-48
# Access token lifetime (seconds). Short-lived; browsers refresh it silently.
ACCESS_TOKEN_TTL_SECONDS=600
# Refresh token / session lifetime (days). Refresh tokens rotate on every use.
REFRESH_TOKEN_TTL_DAYS=30
# A rotated refresh token presented again within this window is treated as a race between tabs,
# after it as theft (the session is revoked).
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
# How recent a sign-in / re-authentication must be for sensitive changes (e.g. account deletion).
RECENT_AUTH_MAX_AGE_SECONDS=300
# Secure cookies. Defaults to true in production and false otherwise; cannot be false in production.
COOKIE_SECURE=
# Rate limits for login, registration, password reset, etc. Keep enabled outside tests.
RATE_LIMIT_ENABLED=true
# End-to-end encrypted direct messages (opt-in per conversation). Off unless set to true.
E2EE_ENABLED=false

# ── Uploads ──────────────────────────────────────────────────────────────────
# Folder for uploaded files (avatars). Relative paths are resolved from backend. Files are never
# stored in MongoDB. Back this folder up together with the database.
UPLOADS_DIR=uploads

# ── File storage (avatars and attachments) ───────────────────────────────────
# local: files in UPLOADS_DIR (development, or one server with a persistent disk only; many hosts
#        wipe the filesystem on deploy). s3: any S3-compatible private bucket (AWS S3, Cloudflare
#        R2, MinIO, Backblaze B2…). The bucket must NOT be public; the API streams every file
#        after an access check. Keys stay on the server and never reach the browser.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO/R2-style URLs (endpoint/bucket/key); false for virtual-hosted (bucket.endpoint/key)
S3_FORCE_PATH_STYLE=true

# ── Messages and attachments ─────────────────────────────────────────────────
# Seconds after sending during which a text message can be edited / deleted for everyone (0 = off)
MESSAGE_EDIT_WINDOW_SECONDS=900
MESSAGE_DELETE_WINDOW_SECONDS=3600
# Storage quotas in MB (each file is at most 5 MB)
ATTACHMENT_USER_QUOTA_MB=200
ATTACHMENT_TOTAL_QUOTA_MB=10240
# Uploads never used in a message are deleted after this many minutes
ATTACHMENT_ORPHAN_MINUTES=60

# ── Calls (WebRTC) ───────────────────────────────────────────────────────────
# STUN lets browsers find a direct path. The default is Google's free public STUN server.
STUN_URLS=stun:stun.l.google.com:19302
# TURN relays media when no direct path exists (strict NATs, many mobile and corporate
# networks). Without it some calls will fail to connect. Use your own coturn server (free,
# open source) or a provider that supports the TURN REST API shared-secret scheme, e.g.
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
#   coturn: use-auth-secret + static-auth-secret=<same value as TURN_SECRET>
TURN_URLS=
# Shared secret used to mint short-lived TURN credentials per user (never sent to browsers).
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
# An unanswered call is recorded as missed after this many seconds
CALL_RING_TIMEOUT_SECONDS=45

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Create an OAuth client (type "Web application") in Google Cloud Console and register this exact
# authorized redirect URI: <WEB_APP_URL>/api/v1/auth/google/callback
#   local:      http://localhost:5173/api/v1/auth/google/callback
#   production: https://<your-domain>/api/v1/auth/google/callback
# Leave both empty to disable Google sign-in. The secret stays here (API only), never in frontend.
# See "Setting up Google sign-in" in the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the callback is served at another public URL (must match the registered URI exactly;
# https in production). Defaults to ${WEB_APP_URL}/api/v1/auth/google/callback.
GOOGLE_REDIRECT_URI=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Required in production. Without SMTP_HOST in development, emails (with their links) are
# written to the API log instead. For local testing, Mailpit (open source) works well:
#   SMTP_HOST=127.0.0.1  SMTP_PORT=1025  -> view mail at http://localhost:8025
# Gmail: SMTP_USER is the Gmail address, SMTP_PASSWORD a Google app password
# (Google Account -> Security -> App passwords), and EMAIL_FROM must use the same address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=Connect <you@gmail.com>
