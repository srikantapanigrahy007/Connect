{
  "name": "@connect/api",
  "version": "0.1.0",
  "private": true,
  "description": "Connect REST + real-time API",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#shared": "./src/shared/index.js"
  },
  "main": "./src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "admin:bootstrap": "node scripts/bootstrap-super-admin.js",
    "db:indexes": "node scripts/sync-indexes.js",
    "db:e2ee-slots": "node scripts/e2ee-device-slots.js",
    "test:e2ee": "vitest run e2ee",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "openid-client": "^6.8.8",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@matrix-org/matrix-sdk-crypto-wasm": "18.9.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
